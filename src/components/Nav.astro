      <div class="drop-menu">
        <a href="/features/transactions"><span class="di"><svg class="ic" viewBox="0 0 24 24"><path d="M7 7h11M7 7l3-3M7 7l3 3M17 17H6M17 17l-3-3M17 17l-3 3"/></svg></span><div>Transactions<small>Track &amp; import</small></div></a>
        <a href="/features/budgets"><span class="di"><svg class="ic" viewBox="0 0 24 24"><path d="M3 12a9 9 0 1 0 9-9v9z"/></svg></span><div>Budgets<small>Limits &amp; alerts</small></div></a>
        <a href="/features/goals"><span class="di"><svg class="ic" viewBox="0 0 24 24"><circle cx="12" cy="12" r="9"/><circle cx="12" cy="12" r="4"/></svg></span><div>Goals<small>Track your saving</small></div></a>
        <a href="/features/bills"><span class="di"><svg class="ic" viewBox="0 0 24 24"><path d="M6 3h12v18l-3-2-3 2-3-2-3 2zM9 8h6M9 12h6"/></svg></span><div>Bills &amp; reminders<small>Never miss one</small></div></a>
        <a href="/features/insights"><span class="di"><svg class="ic" viewBox="0 0 24 24"><path d="M4 19V5M4 19h16M8 16v-5M12 16V8M16 16v-3"/></svg></span><div>Insights<small>Where it goes</small></div></a>
      </div>
    </div>
    <a href="/guides/">Guides</a>
    <a href="/learn/">Learn</a>
    <div class="has-drop">
      <button type="button" class="drop-btn" aria-haspopup="true">Tools <svg class="ic" viewBox="0 0 24 24"><path d="M6 9l6 6 6-6"/></svg></button>
      <div class="drop-menu">
        <a href="/quiz"><span class="di"><svg class="ic" viewBox="0 0 24 24"><path d="M9 9a3 3 0 1 1 4 2.83c-.7.4-1 .84-1 1.67M12 17h.01"/></svg></span><div>Money quiz<small>Your spending type</small></div></a>
