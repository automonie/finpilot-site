---
import { urlFor } from '../sanity/lib/image';

// An inline image inside a portable-text body, served as WebP from the Sanity
// CDN, lazy-loaded, with the required alt text and an optional caption.
const { node } = Astro.props;
const src = urlFor(node).width(1400).url();
const alt = node?.alt || '';
const caption = node?.caption;
---
<figure>
  <img src={src} alt={alt} loading="lazy" decoding="async" />
  {caption && <figcaption>{caption}</figcaption>}
</figure>
