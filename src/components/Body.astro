---
import { PortableText } from 'astro-portabletext';
import type { PortableTextComponents } from 'astro-portabletext/types';
import { urlFor } from '../sanity/lib/image';
import BodyImage from './BodyImage.astro';

// Renders the CMS portable-text body: real <h2>/<h3>, lazy images with alt text.
interface Props { value: unknown }
const { value } = Astro.props;

const components: PortableTextComponents = {
  type: { image: BodyImage },
};
---
<div class="prose">
  <PortableText value={value as any} components={components} />
</div>
