---
import { urlFor } from '../sanity/lib/image';

// Author byline, required on every article (E-E-A-T for finance/YMYL content).
const { author, publishedAt, updatedAt } = Astro.props;
const photo = author?.photo ? urlFor(author.photo).width(72).height(72).url() : null;
const fmt = (d?: string) => (d ? new Date(d).toLocaleDateString('en-GB', { day: 'numeric', month: 'short', year: 'numeric' }) : '');
---
<div class="byline">
  {photo && <img src={photo} alt={author?.photo?.alt || author?.name || ''} loading="lazy" />}
  <span>
    <strong>{author?.name}</strong>{author?.role ? ` · ${author.role}` : ''}
    <span class="creds">{author?.credentials}</span>
    <span class="creds">
      Published {fmt(publishedAt)}{updatedAt && updatedAt !== publishedAt ? ` · Updated ${fmt(updatedAt)}` : ''}
    </span>
  </span>
</div>
