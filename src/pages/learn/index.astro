---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getArticleList } from '../../sanity/lib/queries';
const articles = await getArticleList();
---
<BaseLayout
  title="Learn | Automonie"
  description="Plain-English money writing for Nigerians: where your money actually goes, and how to take back control."
  path="/learn/"
>
  <h1>Learn</h1>
  <p>Money self-knowledge, in plain English.</p>
  <div class="related-cards spaced">
    {articles.map((a: any) => (
      <a href={`/learn/${a.slug}`}>
        <strong>{a.title}</strong>
        <span class="card-sub">{a.metaDescription}</span>
      </a>
    ))}
  </div>
  {articles.length === 0 && <p class="empty-note">Articles are on the way.</p>}
</BaseLayout>
