<section class="how" id="how">
  <div class="how-inner">
    <div class="section-head reveal"><span class="eyebrow">Get going in minutes</span><h2>How it works</h2></div>
    <div class="steps">
      <div class="step reveal" data-d="1"><div class="step-no">1</div><h3>Create your account</h3><p>Sign up free on the web or the Android app, just your name, email, and phone.</p></div>
