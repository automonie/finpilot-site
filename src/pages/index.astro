---
// Marketing home, the existing polished design, ported into Astro. Uses the
// original stylesheet (public/assets/site.css) + scripts (public/assets/site.js).
// Copy fixed for honest V1 labelling: no "auto-savings does the work", and the
// flag-hidden auto-savings + wallet feature panels are removed. Poppins is
// self-hosted via @fontsource (no Google CDN).
import '@fontsource/poppins/400.css';
import '@fontsource/poppins/500.css';
import '@fontsource/poppins/600.css';
import '@fontsource/poppins/700.css';
const year = new Date().getFullYear();
---
<!doctype html>
<html lang="en">
<head>
<meta charset="UTF-8" />
<meta name="viewport" content="width=device-width, initial-scale=1.0" />
<title>Automonie | Take control of every naira</title>
<meta name="description" content="See where your money actually goes. Automonie reads your Nigerian bank statements and SMS alerts, categorises every naira, and helps you budget, on web and Android." />
<meta name="theme-color" content="#0b1326" />
<link rel="canonical" href="https://automonie.com/" />
<meta name="robots" content="index, follow" />
<meta property="og:type" content="website" />
<meta property="og:site_name" content="Automonie" />
<meta property="og:title" content="Automonie | Take control of every naira" />
<meta property="og:description" content="See where your money actually goes | Automonie reads your statements and SMS alerts and categorises every naira. On web and Android." />
