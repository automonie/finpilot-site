  <div class="stat"><div class="num" data-count="2" data-suffix=" apps">0</div><div class="lab">Web + Android, one account</div></div>
  <div class="stat"><div class="num" data-count="100" data-suffix="%">0</div><div class="lab">Naira-first, free to start</div></div>
