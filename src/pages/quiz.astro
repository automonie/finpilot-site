---
import BaseLayout from '../layouts/BaseLayout.astro';

const jsonLd = [
  { '@context': 'https://schema.org', '@type': 'BreadcrumbList', itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Home', item: 'https://automonie.com/' },
    { '@type': 'ListItem', position: 2, name: 'Money Personality Quiz', item: 'https://automonie.com/quiz' },
  ] },
  { '@context': 'https://schema.org', '@type': 'FAQPage', mainEntity: [
    { '@type': 'Question', name: 'What is a money personality?', acceptedAnswer: { '@type': 'Answer', text: 'Your money personality is the pattern behind how you spend — where your money tends to go, when it disappears, and what you prioritise. Automonie sorts Nigerian spenders into eight archetypes, from the disciplined Ajo Loyalist to the untraceable Ghost Spender.' } },
    { '@type': 'Question', name: 'Is the money personality quiz free?', acceptedAnswer: { '@type': 'Answer', text: 'Yes. The quiz is completely free and needs no sign-up. It is ten quick questions and gives you your archetype instantly.' } },
    { '@type': 'Question', name: 'How accurate is the quiz?', acceptedAnswer: { '@type': 'Answer', text: 'The quiz is a fun, self-reported snapshot. For the real picture, Automonie reads your actual bank statements and transactions and shows you exactly where your money went.' } },
    { '@type': 'Question', name: 'What are the eight money personalities?', acceptedAnswer: { '@type': 'Answer', text: 'The Ghost Spender, the Last-Week Detonator, the Subscription Collector, the Ajo Loyalist, the Soft-Life Economist, the Sapa Survivor, the Detty Prophet, and the Steady Hand.' } },
  ] },
];
---
<BaseLayout
  title="Money Personality Quiz — Automonie"
  description="Take the free Money Personality Quiz — 10 quick questions to find your Nigerian spending archetype, from the Ajo Loyalist to the Ghost Spender. No sign-up needed."
  path="/quiz"
  jsonLd={jsonLd}
>
  <section class="quiz-hero">
    <span class="eyebrow">Free · no sign-up</span>
    <h1>What's your money personality?</h1>
    <p class="quiz-sub">Ten quick questions to reveal your Nigerian spending archetype — from the disciplined <strong>Ajo Loyalist</strong> to the untraceable <strong>Ghost Spender</strong>. Be honest. It's just you and the numbers.</p>
  </section>

  <section id="quizStage" class="quiz-stage" aria-live="polite">
    <noscript><p>Please enable JavaScript to take the quiz.</p></noscript>
  </section>

  <section class="quiz-about">
    <h2>The 8 money personalities</h2>
    <p class="about-intro">Every spender falls into a pattern. These are the eight Automonie archetypes — computed in the app from your real transactions, and approximated here from your answers. Which one are you?</p>
    <div class="type-grid">
      <div class="type-card"><h3>The Ghost Spender</h3><p>Money enter, money disappear. Most of it vanishes into transfers and untracked cash — no receipts, no memory.</p></div>
      <div class="type-card"><h3>The Last-Week Detonator</h3><p>Three weeks of discipline, then the last week undoes all of it. The damage is always late, never early.</p></div>
      <div class="type-card"><h3>The Subscription Collector</h3><p>Funding apps you forgot you married. Small recurring charges quietly meet monthly to remove your money.</p></div>
      <div class="type-card"><h3>The Ajo Loyalist</h3><p>Discipline is your middle name. You save before you spend, small small, consistently. The tortoise that wins.</p></div>
      <div class="type-card"><h3>The Soft-Life Economist</h3><p>Soft life, but the numbers still add up. You enjoy the finer things and still finish the month in the green.</p></div>
      <div class="type-card"><h3>The Sapa Survivor</h3><p>More goes out than comes in, yet you survive on pure strategy. Every naira is doing overtime.</p></div>
      <div class="type-card"><h3>The Detty Prophet</h3><p>You planned to save. You spent. No regrets. Nearly everything that lands goes back out — and the vibes were immaculate.</p></div>
      <div class="type-card"><h3>The Steady Hand</h3><p>No drama, no chaos — just a balanced month. Spending spread out and under control. Quietly winning.</p></div>
    </div>
  </section>

  <section class="quiz-cta">
    <h2>Know your type. Now see the receipts.</h2>
    <p>A quiz is a mirror. Automonie is the full picture — import your bank statement or paste your alerts, and it shows you exactly where every naira went. Free, on web and Android.</p>
    <div class="cta-btns">
      <a class="btnp" href="/download">Get the app</a>
      <a class="btng" href="https://app.automonie.com">Open web app</a>
    </div>
  </section>
</BaseLayout>

<!-- Template-rendered elements: Astro-scoped styling is fine here. -->
<style>
  .quiz-hero{text-align:center;padding:8px 0}
  .quiz-hero h1{font-size:clamp(2rem,6vw,3rem);margin:12px 0 10px;line-height:1.1}
  .quiz-sub{color:var(--ink-2);font-size:1.08rem;line-height:1.6;max-width:620px;margin:0 auto}
  .quiz-stage{margin:26px 0;background:#fff;border:1px solid var(--line);border-radius:20px;padding:clamp(20px,4vw,34px);box-shadow:0 10px 40px rgba(11,19,38,.06)}
  .quiz-about{margin:56px 0 0;text-align:center}
  .quiz-about h2{font-size:clamp(1.6rem,4vw,2.1rem);margin:0 0 10px}
  .about-intro{color:var(--ink-2);line-height:1.6;max-width:640px;margin:0 auto 26px}
  .type-grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(240px,1fr));gap:16px;text-align:left}
  .type-card{background:#fff;border:1px solid var(--line);border-radius:16px;padding:20px}
  .type-card h3{margin:0 0 8px;font-size:1.12rem}
  .type-card p{margin:0;color:var(--ink-2);line-height:1.55;font-size:.96rem}
  .quiz-cta{margin:56px 0 0;text-align:center;background:linear-gradient(135deg,#139DA0,#0891b2);color:#eafff5;border-radius:22px;padding:clamp(28px,5vw,44px)}
  .quiz-cta h2{color:#fff;font-size:clamp(1.5rem,4vw,2rem);margin:0 0 10px}
  .quiz-cta p{max-width:560px;margin:0 auto 22px;line-height:1.6;opacity:.94}
  .cta-btns{display:flex;gap:12px;justify-content:center;flex-wrap:wrap}
  .btnp{display:inline-block;background:var(--grad);color:#06231c;border:0;border-radius:12px;padding:13px 22px;font:inherit;font-weight:600;text-decoration:none;cursor:pointer}
  .btng{display:inline-block;background:rgba(255,255,255,.16);color:#fff;border-radius:12px;padding:13px 22px;font-weight:600;text-decoration:none}
</style>

<!-- The quiz question/result UI is injected at runtime by the inline script below.
     Those elements never carry Astro's data-astro-cid attribute, so scoped styles
     would NOT reach them — they MUST be global. Namespaced under #quizStage so the
     generic q-* / .btn-primary class names can't leak into the rest of the site. -->
<style is:global>
  #quizStage .q-progress{height:6px;border-radius:6px;background:#eef1f5;overflow:hidden;margin-bottom:14px}
  #quizStage .q-progress span{display:block;height:100%;background:linear-gradient(90deg,#139DA0,#1DD3A8);transition:width .35s ease}
  #quizStage .q-count{font-size:.82rem;font-weight:700;letter-spacing:.4px;text-transform:uppercase;color:#8a97a8;margin-bottom:8px}
  #quizStage .q-title{font-size:clamp(1.3rem,3.5vw,1.7rem);line-height:1.3;margin:0 0 20px}
  #quizStage .q-opts{display:flex;flex-direction:column;gap:12px}
  #quizStage .q-opt{text-align:left;background:#f7f9fb;border:2px solid #eef1f5;border-radius:14px;padding:16px 18px;font:inherit;font-size:1.02rem;font-weight:600;color:var(--ink);cursor:pointer;transition:border-color .15s,background .15s,transform .1s;animation:qIn .4s cubic-bezier(.2,.7,.2,1) both}
  #quizStage .q-opt:hover{border-color:#1DD3A8;background:#f0fbf7}
  #quizStage .q-opt:active{transform:scale(.99)}
  #quizStage .q-opt.sel{border-color:#1DD3A8;background:#e9fbf4;transform:scale(1.01)}
  #quizStage .q-opt:disabled{cursor:default}
  #quizStage .q-back{margin-top:18px;background:none;border:none;color:#8a97a8;font:inherit;font-weight:700;cursor:pointer;padding:4px}
  #quizStage .q-result{text-align:center}
  #quizStage .q-badge{width:74px;height:74px;border-radius:50%;margin:0 auto 14px;display:flex;align-items:center;justify-content:center;background:var(--acc);animation:qPop .55s cubic-bezier(.2,.8,.3,1.3) both}
  #quizStage .q-eyebrow{font-size:.8rem;font-weight:800;letter-spacing:.6px;text-transform:uppercase;color:var(--acc)}
  #quizStage .q-name{font-size:clamp(1.7rem,5vw,2.4rem);margin:6px 0 10px;color:var(--acc)}
  #quizStage .q-tag{font-size:1.12rem;font-weight:600;color:var(--ink);margin:0 0 12px}
  #quizStage .q-blurb{color:var(--ink-2);line-height:1.6;max-width:520px;margin:0 auto 22px}
  #quizStage .q-actions{display:flex;gap:12px;justify-content:center;flex-wrap:wrap;margin-bottom:26px}
  #quizStage .btn-primary{display:inline-block;background:var(--grad);color:#06231c;border:0;border-radius:12px;padding:13px 22px;font:inherit;font-weight:600;text-decoration:none;cursor:pointer}
  #quizStage .q-retake{background:none;border:2px solid var(--line);border-radius:999px;padding:12px 22px;font:inherit;font-weight:700;color:var(--ink-2);cursor:pointer}
  #quizStage .q-capture{border-top:1px solid #eef1f5;padding-top:22px}
  #quizStage .q-cap-title{font-size:1rem;line-height:1.55;color:var(--ink);font-weight:600;max-width:520px;margin:0 auto 16px}
  #quizStage .q-form{display:flex;gap:10px;max-width:460px;margin:0 auto;flex-wrap:wrap}
  #quizStage .q-input{flex:1;min-width:200px;background:#fff;border:2px solid var(--line);border-radius:12px;padding:13px 15px;font:inherit;font-size:1rem;outline:none}
  #quizStage .q-input:focus{border-color:#1DD3A8}
  #quizStage .q-msg{min-height:20px;margin:12px 0 0;font-weight:600;color:#0f6e56}
  #quizStage .q-msg.err{color:#c0392b}
  #quizStage .q-anim{animation:qIn .42s cubic-bezier(.2,.7,.2,1) both}
  #quizStage .q-loading{text-align:center;padding:34px 0}
  #quizStage .q-dots{display:flex;gap:11px;justify-content:center;margin-bottom:16px}
  #quizStage .q-dots span{width:14px;height:14px;border-radius:50%;background:#1DD3A8;animation:qPulse 1s ease-in-out infinite}
  #quizStage .q-dots span:nth-child(2){animation-delay:.15s}
  #quizStage .q-dots span:nth-child(3){animation-delay:.3s}
  #quizStage .q-loading-text{color:var(--ink-2);font-weight:600}
  #quizStage .q-result .r1,#quizStage .q-result .r2,#quizStage .q-result .r3,#quizStage .q-result .r4,#quizStage .q-result .r5,#quizStage .q-result .r6{animation:qIn .5s ease both}
  #quizStage .q-result .r1{animation-delay:.14s}#quizStage .q-result .r2{animation-delay:.22s}#quizStage .q-result .r3{animation-delay:.32s}#quizStage .q-result .r4{animation-delay:.42s}#quizStage .q-result .r5{animation-delay:.54s}#quizStage .q-result .r6{animation-delay:.66s}
  @keyframes qIn{from{opacity:0;transform:translateY(16px)}to{opacity:1;transform:none}}
  @keyframes qPop{0%{opacity:0;transform:scale(.5)}60%{transform:scale(1.1)}100%{opacity:1;transform:scale(1)}}
  @keyframes qPulse{0%,100%{opacity:.3;transform:scale(.7)}50%{opacity:1;transform:scale(1)}}
  @media(max-width:520px){#quizStage .q-form{flex-direction:column}#quizStage .q-input,#quizStage .q-form .btn-primary{width:100%}}
  @media(prefers-reduced-motion:reduce){#quizStage .q-anim,#quizStage .q-opt,#quizStage .q-badge,#quizStage .q-result [class*=r]{animation:none!important}}
</style>

<script is:inline>
(function () {
  var API = 'https://api.automonie.com';
  var ARCHETYPES = {
    ghost:     { name: 'The Ghost Spender',        color: '#6b7280', tagline: 'Money enter, money disappear. No receipts, no memory.', blurb: 'Most of your money vanishes into transfers and untracked cash. You are not broke, you are just haunted by spending you never see.' },
    detonator: { name: 'The Last-Week Detonator',  color: '#ef4444', tagline: 'Three weeks of discipline, then the last week undid all of it.', blurb: 'You hold it together for most of the month, then the final seven days detonate the budget. The damage is always late, never early.' },
    subs:      { name: 'The Subscription Collector',color: '#8b5cf6', tagline: 'You are funding apps you forgot you married.', blurb: 'Small recurring charges have quietly formed a committee that meets monthly to remove your money. Half of them you have not opened in months.' },
    ajo:       { name: 'The Ajo Loyalist',          color: '#0ea5e9', tagline: 'Discipline na your middle name. Small small, consistently.', blurb: 'You put money away before you spend, every single time. Slow, steady, unbothered, the tortoise that quietly wins.' },
    softlife:  { name: 'The Soft-Life Economist',   color: '#f59e0b', tagline: 'Soft life, but the numbers still add up. Enjoyment with sense.', blurb: 'You enjoy the finer things and still finish the month in the green. Treats, yes, but calculated treats.' },
    sapa:      { name: 'The Sapa Survivor',         color: '#f97316', tagline: 'You stretched the last change into a full week. Legend.', blurb: 'More goes out than comes in, and yet you survive on pure strategy. Every naira is doing overtime.' },
    detty:     { name: 'The Detty Prophet',         color: '#ec4899', tagline: 'You planned to save. You spent. No regrets, prophet.', blurb: 'Nearly everything that lands goes right back out, and you enjoyed every bit of it. The vibes were, respectfully, immaculate.' },
    steady:    { name: 'The Steady Hand',           color: '#14b8a6', tagline: 'No drama, no chaos, just a balanced month.', blurb: 'Your spending is spread out and under control. No plot twists, no panic. Quietly, consistently winning.' },
  };
  var PRIORITY = ['ghost', 'detonator', 'subs', 'ajo', 'softlife', 'sapa', 'detty', 'steady'];
  var QUESTIONS = [
    { q: "It's the end of the month. Where did your money actually go?", a: [
      { t: "Honestly? No idea. It just vanished.", w: { ghost: 2 } },
      { t: "The last week did most of the damage.", w: { detonator: 2 } },
      { t: "Subscriptions and small charges, everywhere.", w: { subs: 2 } },
      { t: "I saved a good chunk before I spent anything.", w: { ajo: 2 } } ] },
    { q: 'Your salary just landed. First move?', a: [
      { t: 'Move part to savings immediately.', w: { ajo: 2 } },
      { t: 'Treat myself, I earned it.', w: { detty: 2, softlife: 1 } },
      { t: 'Clear the debts and transfers I owe.', w: { sapa: 1, ghost: 1 } },
      { t: 'Nothing dramatic, carry on as normal.', w: { steady: 2 } } ] },
    { q: 'How many subscriptions are you paying for right now?', a: [
      { t: "I genuinely don't know.", w: { subs: 2, ghost: 1 } },
      { t: 'Four or more, and I use maybe two.', w: { subs: 2 } },
      { t: 'One or two, deliberate.', w: { steady: 1, ajo: 1 } },
      { t: 'Zero. I cancel fast.', w: { sapa: 1, steady: 1 } } ] },
    { q: "What's your usual spending rhythm?", a: [
      { t: 'Calm all month, then chaos in the last week.', w: { detonator: 2 } },
      { t: 'Steady and spread out.', w: { steady: 2 } },
      { t: 'Big treats whenever the vibe is right.', w: { softlife: 2, detty: 1 } },
      { t: "Bare minimum, I'm surviving.", w: { sapa: 2 } } ] },
    { q: "Where does most of your 'fun' money go?", a: [
      { t: 'Eating out, delivery, the good life.', w: { softlife: 2, detty: 1 } },
      { t: 'Nights out, betting, entertainment.', w: { detty: 2 } },
      { t: "I don't really have fun money.", w: { sapa: 2, ajo: 1 } },
      { t: "Transfers I can't even trace later.", w: { ghost: 2 } } ] },
    { q: 'By the 25th of the month, you are usually...', a: [
      { t: 'Still comfortable.', w: { steady: 1, ajo: 1 } },
      { t: 'Counting coins, planning survival.', w: { sapa: 2 } },
      { t: 'Wondering where it all went.', w: { ghost: 2, detonator: 1 } },
      { t: 'Fine, I front-loaded my savings.', w: { ajo: 2 } } ] },
    { q: 'A friend asks to borrow money, three days to payday. You...', a: [
      { t: 'Send it, figure mine out later.', w: { detty: 1, ghost: 1 } },
      { t: "Politely say I'm also managing.", w: { sapa: 2 } },
      { t: 'Send it, I planned a buffer for this.', w: { ajo: 1, steady: 1 } },
      { t: "I don't even know if I can spare it.", w: { ghost: 1, subs: 1 } } ] },
    { q: 'Your ideal free weekend?', a: [
      { t: 'Brunch, cinema, a nice outing.', w: { softlife: 2 } },
      { t: 'Turn-up, drinks, the full detty.', w: { detty: 2 } },
      { t: 'Home and rested. Rest is free.', w: { steady: 1, ajo: 1, sapa: 1 } },
      { t: "Anything, as long as I'm not counting cash.", w: { ghost: 1, detonator: 1 } } ] },
    { q: 'How often do you actually check your balance?', a: [
      { t: 'Constantly, I know it to the naira.', w: { sapa: 1, ajo: 1 } },
      { t: 'Only when the alert scares me.', w: { detonator: 1, ghost: 1 } },
      { t: 'Weekly-ish, I like to stay aware.', w: { steady: 2 } },
      { t: 'I avoid it. Ignorance is peace.', w: { ghost: 2 } } ] },
    { q: 'Pick your money mantra:', a: [
      { t: '"Save first, flex later."', w: { ajo: 2 } },
      { t: '"You only live once."', w: { detty: 2 } },
      { t: '"Soft life, but calculated."', w: { softlife: 2 } },
      { t: '"Whatever remains is savings."', w: { ghost: 1, detonator: 1 } } ] },
  ];
  var scores = {}, idx = 0, answered = [];
  var el = function (id) { return document.getElementById(id); };
  var stage = el('quizStage');
  function start(){ scores={}; idx=0; answered=[]; PRIORITY.forEach(function(k){scores[k]=0;}); renderQuestion(); }
  function renderQuestion(){
    var Q=QUESTIONS[idx]; var pct=Math.round((idx)/QUESTIONS.length*100); var opts='';
    Q.a.forEach(function(opt,i){ opts+='<button class="q-opt" data-i="'+i+'" style="animation-delay:'+(80+i*70)+'ms">'+opt.t+'</button>'; });
    stage.innerHTML='<div class="q-anim"><div class="q-progress"><span style="width:'+pct+'%"></span></div><div class="q-count">Question '+(idx+1)+' of '+QUESTIONS.length+'</div><h2 class="q-title">'+Q.q+'</h2><div class="q-opts">'+opts+'</div>'+(idx>0?'<button class="q-back" id="qBack">Back</button>':'')+'</div>';
    stage.scrollIntoView({behavior:'smooth',block:'start'});
    var os=stage.querySelectorAll('.q-opt');
    for(var j=0;j<os.length;j++){ os[j].addEventListener('click',function(){ pick(this,+this.getAttribute('data-i')); }); }
    var back=el('qBack'); if(back) back.addEventListener('click',goBack);
  }
  function pick(btn,i){ var all=stage.querySelectorAll('.q-opt'); for(var j=0;j<all.length;j++) all[j].disabled=true; btn.classList.add('sel'); setTimeout(function(){choose(i);},280); }
  function choose(i){ var w=QUESTIONS[idx].a[i].w; answered[idx]=w; for(var k in w) scores[k]+=w[k]; idx++; if(idx>=QUESTIONS.length) interstitial(); else renderQuestion(); }
  function goBack(){ if(idx===0)return; idx--; var w=answered[idx]; if(w){ for(var k in w) scores[k]-=w[k]; answered[idx]=null; } renderQuestion(); }
  function interstitial(){ stage.innerHTML='<div class="q-anim q-loading"><div class="q-dots"><span></span><span></span><span></span></div><p class="q-loading-text">Reading your spending DNA...</p></div>'; stage.scrollIntoView({behavior:'smooth',block:'start'}); setTimeout(renderResult,1400); }
  function winner(){ var best=PRIORITY[0],bestN=-1; PRIORITY.forEach(function(k){ if(scores[k]>bestN){bestN=scores[k];best=k;} }); return best; }
  function renderResult(){
    var A=ARCHETYPES[winner()];
    stage.innerHTML='<div class="q-anim q-result" style="--acc:'+A.color+'"><div class="q-badge"><svg viewBox="0 0 24 24" width="34" height="34" fill="none" stroke="#fff" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="8" r="4"/><path d="M4 21c0-4 4-6 8-6s8 2 8 6"/></svg></div><div class="q-eyebrow r1">Your money personality</div><h2 class="q-name r2">'+A.name+'</h2><p class="q-tag r3">'+A.tagline+'</p><p class="q-blurb r4">'+A.blurb+'</p><div class="q-actions r5"><button class="btn-primary" id="qShare">Share my result</button><button class="q-retake" id="qRetake">Retake quiz</button></div><div class="q-capture r6"><p class="q-cap-title">This is just the surface. Automonie reads your real transactions and shows you where your money actually went, free.</p><form id="qForm" class="q-form" novalidate><input id="qEmail" class="q-input" type="email" inputmode="email" autocomplete="email" placeholder="you@email.com" aria-label="Email" required><button class="btn-primary" type="submit" id="qJoin">Get early access</button></form><p class="q-msg" id="qMsg" role="status" aria-live="polite"></p></div></div>';
    stage.scrollIntoView({behavior:'smooth',block:'start'});
    el('qRetake').addEventListener('click',start);
    el('qShare').addEventListener('click',function(){share(A);});
    el('qForm').addEventListener('submit',function(e){e.preventDefault();join();});
  }
  function share(A){
    // One message carrying BOTH the result and the link. We deliberately DON'T pass a
    // separate `url` to navigator.share — most apps (WhatsApp, etc.) then keep only the
    // url and drop the result text; folding the link into `text` guarantees both show.
    var msg='My money personality is '+A.name+'. "'+A.tagline+'"\n\nWhat’s yours? Take the free Automonie quiz → https://automonie.com/quiz';
    if(navigator.share){ navigator.share({title:'My Automonie money personality',text:msg}).catch(function(){}); return; }
    var btn=el('qShare');
    try{ navigator.clipboard.writeText(msg); var prev=btn.textContent; btn.textContent='Copied — paste it anywhere!'; setTimeout(function(){btn.textContent=prev;},1800); }
    catch(e){ window.open('https://wa.me/?text='+encodeURIComponent(msg),'_blank'); }
  }
  function join(){
    var email=el('qEmail'),msg=el('qMsg'),btn=el('qJoin'); var v=(email.value||'').trim();
    if(!/^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(v)){ msg.textContent='Please enter a valid email.'; msg.className='q-msg err'; return; }
    btn.disabled=true; btn.textContent='Joining...'; msg.textContent=''; msg.className='q-msg';
    fetch(API+'/api/waitlist',{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify({email:v,source:'quiz'})})
      .then(function(r){ return r.json().then(function(d){ return {ok:r.ok,d:d}; }); })
      .then(function(res){ if(res.ok){ el('qForm').reset(); msg.textContent="You're on the list! We'll email you at launch."; msg.className='q-msg'; btn.textContent='Joined'; } else { msg.textContent=(res.d&&res.d.message)||'Something went wrong.'; msg.className='q-msg err'; btn.disabled=false; btn.textContent='Get early access'; } })
      .catch(function(){ msg.textContent='Network error. Please try again.'; msg.className='q-msg err'; btn.disabled=false; btn.textContent='Get early access'; });
  }
  if(stage) start();
})();
</script>
