---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { features } from '../../data/features';
---
<BaseLayout
  title="Features | Automonie"
  description="Everything Automonie does: automatic transaction tracking, budgets that warn you early, goals you can track, bill reminders, and money insights."
  path="/features/"
>
  <h1 id="features">Features</h1>
  <p>Automonie reads your money and shows you the truth. Here's what it does.</p>
  <div class="related-cards spaced">
    {features.map((f) => (
      <a href={`/features/${f.slug}`}>
        <strong>{f.title}</strong>
        <span class="card-sub">{f.description}</span>
      </a>
    ))}
  </div>
</BaseLayout>
